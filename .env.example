# Copy this file to .env.local and fill in secrets locally.
# Never expose these variables with a VITE_ prefix: the API key is server-only.
# Per-key precedence: process.env > .env.local > .env > .env.example.

# Local web and service ports (all services remain bound to 127.0.0.1)
WEB_SERVER_PORT=5173
WEB_PREVIEW_PORT=4173
PRICE_SERVER_PORT=5174
# Used only by explicit backup/deployment operations. Keep the real value in a private 0600 environment file.
BUILDSIM_BACKUP_PASSWORD=<generate-a-strong-local-backup-password>
AGENT_SERVER_PORT=5175
WORKSPACE_SERVER_PORT=5176
PLAN_REPOSITORY_ROOT=runtime/plans

# DeepSeek advice service
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_AGENT_MODELS=deepseek-v4-flash,deepseek-v4-pro,deepseek-v4-flash-vision-exp
DEEPSEEK_AGENT_MAX_TOKENS=8192
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_TOKENS=1200
DEEPSEEK_TEMPERATURE=0.2
BUILD_SIM_ADVICE_ENABLED=false
# Advice audit/job roots are selected from the active RuntimeCoordinator
# generation. BUILD_SIM_ADVICE_*_ROOT is retained only for isolated fixtures.

# Provider-neutral Agent service (server-only)
BUILD_SIM_AGENT_ENABLED=false
AGENT_MAX_MODEL_TURNS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_REPEATED_TOOL_CALLS=2
AGENT_MAX_TOOL_RESULT_BYTES=160000
AGENT_MAX_MESSAGE_CHARS=20000
AGENT_REQUEST_BODY_MAX_BYTES=1000000
# Agent session/audit roots are selected from the active RuntimeCoordinator
# generation. AGENT_*_ROOT is retained only for isolated fixtures.
BUILD_SIM_SKILLS_ROOT=skills

# Optional Claude adapter (not registered unless both Agent and Claude are enabled)
CLAUDE_ENABLED=false
CLAUDE_API_KEY=
CLAUDE_API_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_TIMEOUT_MS=30000
CLAUDE_MAX_TOKENS=1200
CLAUDE_TEMPERATURE=0.2

# Price/catalog service safety and persistence
PRICE_REQUEST_BODY_MAX_BYTES=1000000
TRANSACTION_SCREENSHOT_BODY_MAX_BYTES=7000000
TRANSACTION_SCREENSHOT_OCR_TIMEOUT_MS=60000
# Transaction archive is selected from the active RuntimeCoordinator generation.
# TRANSACTION_ARCHIVE_ROOT is retained only for isolated fixtures.
TRANSACTION_OCR_PROVIDER=deepseek-ocr
# Defaults to DEEPSEEK_API_URL / DEEPSEEK_API_KEY when left blank.
DEEPSEEK_OCR_API_URL=
DEEPSEEK_OCR_API_KEY=
DEEPSEEK_OCR_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_OCR_MAX_TOKENS=2048
TRANSACTION_CATALOG_DISCOVERY_PROVIDER=searxng
CATALOG_PERSIST_ROOT=runtime
BUILD_SIM_CATALOG_WRITE_ENABLED=false

# Universal hardware platform rollout gates. U0 freezes the contracts only;
# every new runtime path remains disabled until its own stage gates pass.
BUILD_SIM_TOPOLOGY_V3_ENABLED=false
BUILD_SIM_FACT_GRAPH_ENABLED=false
BUILD_SIM_AGENT_INFERENCE_ENABLED=false
BUILD_SIM_USER_OBSERVATIONS_ENABLED=false
BUILD_SIM_GENERIC_ADAPTERS_ENABLED=false
BUILD_SIM_SPATIAL_ROUTING_ENABLED=false
BUILD_SIM_PROGRESSIVE_EVALUATION_ENABLED=false
BUILD_SIM_THERMAL_V3_ENABLED=false
BUILD_SIM_ACOUSTIC_V3_ENABLED=false
BUILD_SIM_SYSTEM_PROFILES_ENABLED=false
BUILD_SIM_WHOLE_BUILD_SOLVER_ENABLED=false
BUILD_SIM_SCENARIO_WHAT_IF_ENABLED=false
BUILD_SIM_BUILD_EXECUTION_V3_ENABLED=false
BUILD_SIM_STORAGE_LAYOUT_ENABLED=false
BUILD_SIM_PRICE_HISTORY_ENABLED=false
BUILD_SIM_PRICE_TARGETS_ENABLED=false
BUILD_SIM_RECOMMENDATIONS_ENABLED=false
BUILD_SIM_PRICE_NETWORK_ENABLED=false
BUILD_SIM_DURABLE_JOBS_ENABLED=false
BUILD_SIM_EVIDENCE_NETWORK_ENABLED=false
BUILD_SIM_PORTABILITY_ENABLED=false
BUILD_SIM_BACKUP_RESTORE_ENABLED=false
BUILD_SIM_DOCTOR_REPAIR_ENABLED=false
CATALOG_FETCH_TIMEOUT_MS=15000
CATALOG_FETCH_MAX_BYTES=5000000
CATALOG_FETCH_MAX_REDIRECTS=4
# Browser renderer for public official product pages: auto prefers the pinned,
# signature-verified CloakBrowser binary and falls back to stock Playwright.
CATALOG_OFFICIAL_BROWSER_RENDERER=auto
CATALOG_BROWSER_HYDRATION_WAIT_MS=1200
# Optional current CloakBrowser entitlement. Keep server-side and never expose
# it with a VITE_ prefix. Without it, the pinned public v146 binary is used.
CLOAKBROWSER_LICENSE_KEY=
CLOAKBROWSER_VERSION=146.0.7680.177.5
CATALOG_PDF_OCR_ENABLED=false
CATALOG_PDF_OCR_MIN_TEXT_CHARS=80
CATALOG_PDF_OCR_MAX_PAGES=3
CATALOG_PDF_OCR_WIDTH=1600
CATALOG_PDF_OCR_TIMEOUT_MS=60000
PRICE_MIN_GAP_MS=3000
PRICE_COOLDOWN_MS=300000

# Headed marketplace browser fallback
PRICE_BROWSER_HEADLESS=false
PRICE_BROWSER_PROFILE_DIR=.cache/price-browser-profile
PRICE_BROWSER_NAV_TIMEOUT_MS=45000
PRICE_BROWSER_CARD_WAIT_MS=15000
PRICE_BROWSER_HYDRATION_WAIT_MS=1200
PRICE_BROWSER_VARIANT_WAIT_MS=2500

# Optional marketplace API credentials (server-only)
JD_APP_KEY=
JD_APP_SECRET=
JD_ACCESS_TOKEN=
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
TAOBAO_SESSION=
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=

# Test-only provider fixture
AGENT_FIXTURE_PORT=5180
BUILD_SIM_BROWSER_LIVE_ADVICE=0

# Official catalog URL discovery (server-only; SearXNG remains opt-in)
CATALOG_DISCOVERY_PROVIDER=registry
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_TIMEOUT_MS=10000
SEARXNG_RESULT_LIMIT=10
CATALOG_DISCOVERY_CACHE_TTL_MS=86400000
CATALOG_AUTO_ENRICH_TRUSTED_OFFICIAL=true
CATALOG_AUTO_ACCEPT_EXACT_MPN=false
CATALOG_AUTO_TRUST_NEW_DOMAINS=false

# Immutable official-document evidence store. Manual acquisition keeps the
# catalog fetcher's HTTPS/allowlist/DNS/redirect/SSRF checks but permits larger
# bounded PDF responses than normal catalog candidate inspection.
EVIDENCE_REPOSITORY_ROOT=runtime/evidence
EVIDENCE_FETCH_TIMEOUT_MS=30000
EVIDENCE_FETCH_MAX_BYTES=25000000
EVIDENCE_FETCH_MAX_REDIRECTS=4
EVIDENCE_CACHE_TTL_MS=86400000
