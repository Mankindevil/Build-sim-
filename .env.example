# Copy this file to .env.local and fill in secrets locally.
# Never expose these variables with a VITE_ prefix: the API key is server-only.
# Per-key precedence: process.env > .env.local > .env > .env.example.

# Local web and service ports (all services remain bound to 127.0.0.1)
WEB_SERVER_PORT=5176
WEB_PREVIEW_PORT=4173
PRICE_SERVER_PORT=5174
AGENT_SERVER_PORT=5175

# DeepSeek advice service
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_AGENT_MODELS=deepseek-v4-flash,deepseek-v4-pro,deepseek-v4-flash-vision-exp
DEEPSEEK_TIMEOUT_MS=30000
DEEPSEEK_MAX_TOKENS=1200
DEEPSEEK_TEMPERATURE=0.2
BUILD_SIM_ADVICE_ENABLED=false
BUILD_SIM_ADVICE_AUDIT_ROOT=data/audit/advice-events
BUILD_SIM_ADVICE_JOB_ROOT=data/audit/advice-jobs

# Provider-neutral Agent service (server-only)
BUILD_SIM_AGENT_ENABLED=false
AGENT_MAX_MODEL_TURNS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_REPEATED_TOOL_CALLS=2
AGENT_MAX_TOOL_RESULT_BYTES=160000
AGENT_MAX_MESSAGE_CHARS=20000
AGENT_REQUEST_BODY_MAX_BYTES=1000000
AGENT_SESSION_ROOT=data/agent/sessions
AGENT_AUDIT_ROOT=data/agent/audit
BUILD_SIM_SKILLS_ROOT=skills

# Optional Claude adapter (not registered unless both Agent and Claude are enabled)
CLAUDE_ENABLED=false
CLAUDE_API_KEY=
CLAUDE_API_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_TIMEOUT_MS=30000
CLAUDE_MAX_TOKENS=1200
CLAUDE_TEMPERATURE=0.2

# Price/catalog service safety and persistence
PRICE_REQUEST_BODY_MAX_BYTES=1000000
TRANSACTION_SCREENSHOT_BODY_MAX_BYTES=7000000
TRANSACTION_SCREENSHOT_OCR_TIMEOUT_MS=60000
TRANSACTION_ARCHIVE_ROOT=runtime/transactions
TRANSACTION_OCR_PROVIDER=deepseek-ocr
# Defaults to DEEPSEEK_API_URL / DEEPSEEK_API_KEY when left blank.
DEEPSEEK_OCR_API_URL=
DEEPSEEK_OCR_API_KEY=
DEEPSEEK_OCR_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_OCR_MAX_TOKENS=2048
TRANSACTION_CATALOG_DISCOVERY_PROVIDER=searxng
CATALOG_PERSIST_ROOT=.
BUILD_SIM_CATALOG_WRITE_ENABLED=false
CATALOG_FETCH_TIMEOUT_MS=15000
CATALOG_FETCH_MAX_BYTES=5000000
CATALOG_FETCH_MAX_REDIRECTS=4
CATALOG_PDF_OCR_ENABLED=false
CATALOG_PDF_OCR_MIN_TEXT_CHARS=80
CATALOG_PDF_OCR_MAX_PAGES=3
CATALOG_PDF_OCR_WIDTH=1600
CATALOG_PDF_OCR_TIMEOUT_MS=60000
PRICE_MIN_GAP_MS=3000
PRICE_COOLDOWN_MS=300000

# Headed marketplace browser fallback
PRICE_BROWSER_HEADLESS=false
PRICE_BROWSER_PROFILE_DIR=.cache/price-browser-profile
PRICE_BROWSER_NAV_TIMEOUT_MS=45000
PRICE_BROWSER_CARD_WAIT_MS=15000
PRICE_BROWSER_HYDRATION_WAIT_MS=1200
PRICE_BROWSER_VARIANT_WAIT_MS=2500

# Optional marketplace API credentials (server-only)
JD_APP_KEY=
JD_APP_SECRET=
JD_ACCESS_TOKEN=
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
TAOBAO_SESSION=
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=

# Test-only provider fixture
AGENT_FIXTURE_PORT=5180
BUILD_SIM_BROWSER_LIVE_ADVICE=0

# Official catalog URL discovery (server-only; SearXNG remains opt-in)
CATALOG_DISCOVERY_PROVIDER=registry
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_TIMEOUT_MS=10000
SEARXNG_RESULT_LIMIT=10
CATALOG_DISCOVERY_CACHE_TTL_MS=86400000
CATALOG_AUTO_ENRICH_TRUSTED_OFFICIAL=true
CATALOG_AUTO_ACCEPT_EXACT_MPN=false
CATALOG_AUTO_TRUST_NEW_DOMAINS=false
