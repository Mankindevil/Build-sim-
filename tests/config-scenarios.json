{
  "schemaVersion": 1,
  "subject": "JONSBO N6 + ASUS Pro WS W680M-ACE SE NAS simulator",
  "purpose": "Handbook-derived compatibility regression scenarios for the interactive build preview",
  "mergeSemantics": "Every scenario input is complete for compatibility evaluation; expected.requiredWarnings is a required subset, not necessarily the complete warning list.",
  "references": {
    "n6Manual": "../references/jonsbo-n6-manual.pdf",
    "w680mManual": "../references/asus-w680m-manual.pdf",
    "preview": "/Users/jintingzhou/.codex/visualizations/2026/08/19/01a018a5-d534-7be3-90cf-24ebf45ab620/n6-build-preview.html"
  },
  "verdicts": {
    "ok": "No known incompatibility or unresolved purchase-critical warning",
    "warn": "Mechanically possible after normalization, but one or more explicit checks remain",
    "bad": "Impossible, officially unsupported, or should not be presented as installable"
  },
  "rules": {
    "N6-DRIVE-001": {
      "level": "official",
      "text": "N6 has nine shared trays; each tray accepts either one 2.5-inch SSD or one 3.5-inch HDD."
    },
    "MB-SATA-001": {
      "level": "official",
      "text": "W680M-ACE SE exposes four native SATA ports plus up to four SATA devices through SlimSAS, for eight motherboard SATA devices total."
    },
    "N6-PSU-001": {
      "level": "official",
      "text": "N6 supports ATX power supplies up to 220 mm and SFX power supplies up to 100 mm."
    },
    "N6-DUAL-001": {
      "level": "official",
      "text": "The manual illustrates ATX+SFX and SFX+SFX dual-power layouts and an independent PSU for the HDD backplane; it does not describe redundant failover."
    },
    "N6-FRONT-001": {
      "level": "inferred",
      "text": "The front SFX rack overlaps at least part of the front 2x120/2x140 or 240 mm radiator plane; a complete fan pair or radiator must not be certified as coexisting without measurement."
    },
    "N6-BOTTOM-SFX-001": {
      "level": "official",
      "text": "Installing the lower SFX PSU requires removal of the left-side fan bracket."
    },
    "N6-COOLER-001": {
      "level": "mixed",
      "text": "N6 publishes a 65-160 mm cooler-height range. Mapping 65 mm to an overhead ATX layout and 160 mm to a cleared upper chamber is a structural inference."
    },
    "N6-GPU-001": {
      "level": "mixed",
      "text": "N6 publishes a 275-320 mm GPU-length range but does not map each endpoint to front fans, SFX PSU, or radiator configurations."
    },
    "MB-PCIE-001": {
      "level": "official",
      "text": "W680M-ACE SE provides a CPU PCIe 5.0 x16 slot, a chipset PCIe 4.0 x4 long slot, and a PCIe 3.0 x1 slot."
    },
    "MB-PCIE-002": {
      "level": "inferred",
      "text": "A single- or dual-slot GPU in the main x16 slot preserves the bottom x4 envelope; a 2.5- or 3-slot GPU intrudes into it."
    },
    "MB-M2-001": {
      "level": "official",
      "text": "Both M.2 slots accept 2242/2260/2280 PCIe 4.0 x4 devices, with no documented SATA or expansion-slot disablement."
    },
    "MB-RAM-001": {
      "level": "official",
      "text": "The board has four DDR5 ECC/non-ECC UDIMM slots; use A2 for one DIMM and A2+B2 for two DIMMs."
    },
    "N6-BPWR-001": {
      "level": "official",
      "text": "The backplane has two SATA-power and two PATA/Molex inputs; the manual recommends all four connected, with one independent PSU lead per input."
    },
    "MB-FAN-001": {
      "level": "official",
      "text": "The board has three chassis-fan headers plus CPU_FAN, CPU_OPT, and W_PUMP+; each listed header is rated up to 3 A / 36 W."
    }
  },
