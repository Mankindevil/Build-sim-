CLAUDE_ENABLED=false

# Transaction, Agent session/audit, and advice roots are selected from the
# active RuntimeCoordinator generation under RUNTIME_ROOT.
BUILD_SIM_SKILLS_ROOT=/app/skills

SEARXNG_SECRET=<generate-on-server>
