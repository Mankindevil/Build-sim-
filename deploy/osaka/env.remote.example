PRICE_SERVER_PORT=5174
BUILDSIM_BACKUP_PASSWORD=<generate-a-strong-deployment-backup-password>
RUNTIME_ROOT=/app/runtime
PRICE_RUNTIME_ROOT=/app/runtime
AGENT_SERVER_PORT=5175
WORKSPACE_SERVER_PORT=5176
PLAN_REPOSITORY_ROOT=/app/runtime/plans
PRICE_REQUEST_BODY_MAX_BYTES=1000000
TRANSACTION_SCREENSHOT_BODY_MAX_BYTES=7000000
