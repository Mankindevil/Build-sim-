{
  "name": "pc-build-sim",
  "version": "0.2.0-alpha",
  "private": true,
  "description": "Modular desktop / NAS PC build simulator — SKU library, occupancy conflict engine, wiring plans, and saved configs.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:g1:browser": "node scripts/g1-browser-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "price:refresh": "node scripts/price-refresh/refresh.mjs",
    "price:search": "node scripts/price-refresh/search.mjs",
    "price:serve": "node scripts/price-server/server.mjs",
    "price:login": "node scripts/price-server/login.mjs",
    "price:fixture": "node scripts/price-server/fixture.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "happy-dom": "^20.11.6",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
