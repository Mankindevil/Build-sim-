{
  "name": "pc-build-sim",
  "version": "0.2.0-alpha",
  "private": true,
  "description": "Modular desktop / NAS PC build simulator — SKU library, occupancy conflict engine, wiring plans, and saved configs.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run agent:build && npm run workspace:build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:g1:browser": "node scripts/g1-browser-smoke.mjs",
    "test:purchase-price:browser": "node scripts/purchase-price-browser-smoke.mjs",
    "test:g7:browser": "node scripts/g7-browser-smoke.mjs",
    "test:workspace:browser": "node scripts/workspace-browser-smoke.mjs",
    "test:spatial:browser": "node scripts/spatial-browser-smoke.mjs",
    "test:agent-plan:browser": "node scripts/agent-plan-browser-smoke.mjs",
    "test:agent-initialization:browser": "node scripts/agent-initialization-browser-smoke.mjs",
    "test:transactions:browser": "node scripts/transaction-plan-browser-smoke.mjs",
    "test:build-tasks:browser": "node scripts/build-task-browser-smoke.mjs",
    "test:platform:browser": "node scripts/platform-acceptance-browser.mjs",
    "test:u7:browser": "node scripts/u7-browser-acceptance.mjs",
    "test:c7:browser": "node scripts/c7-catalog-agent-browser-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "price:refresh": "node scripts/price-refresh/refresh.mjs",
    "price:search": "node scripts/price-refresh/search.mjs",
    "price:serve": "node scripts/price-server/server.mjs",
    "price:login": "node scripts/price-server/login.mjs",
    "price:fixture": "node scripts/price-server/fixture.mjs",
    "runtime:preflight": "node scripts/migrations/migrate-runtime-v1.mjs --preflight",
    "runtime:migrate-legacy": "node scripts/migrations/migrate-runtime-v1.mjs",
    "runtime:migrate-user-data": "node scripts/migrations/isolate-user-data-v1.mjs",
    "runtime:migrate-plans-v3": "vite-node --script scripts/migrations/migrate-plans-v3.ts",
    "runtime:migrate-price-v2": "vite-node --script scripts/migrations/migrate-price-snapshot-v2.ts",
    "runtime:backup:create": "node scripts/backup/create.mjs",
    "runtime:backup:verify": "node scripts/backup/verify.mjs",
    "runtime:backup:restore": "node scripts/backup/restore.mjs",
    "runtime:doctor": "node scripts/doctor.mjs",
    "runtime:bootstrap-access": "node scripts/runtime/bootstrap-access.mjs",
    "runtime:fresh-rebuild": "node scripts/runtime/fresh-governed-rebuild.mjs",
    "doctor": "node scripts/doctor.mjs",
    "runtime:gc": "node scripts/runtime-gc.mjs",
    "evidence:import-bundled": "node scripts/evidence/import-bundled-manuals.mjs",
    "evidence:reacquire-n6": "node scripts/evidence/reacquire-n6-official.mjs",
    "evidence:reacquire-release-official": "node scripts/evidence/reacquire-release-official.mjs",
    "facts:migrate": "node scripts/migrations/migrate-facts-v1.mjs",
    "facts:scan-official": "node scripts/facts/scan-official.mjs",
    "agent:build": "vite build --config vite.agent.config.ts",
    "agent:serve": "npm run agent:build && node dist-agent/agent-server.js",
    "agent:fixture": "node scripts/agent-provider-fixture.mjs",
    "agent:secret-scan": "node scripts/agent-secret-scan.mjs",
    "agent:live-smoke": "vite-node scripts/agent-live-smoke.ts",
    "workspace:build": "vite build --config vite.workspace.config.ts",
    "test:workspace:governed-dist": "npm run workspace:build && node scripts/smoke-workspace-governed-evaluation.mjs",
    "release:canary": "vite-node --script scripts/release/universal-canary.ts",
    "release:journey-manifest": "vite-node --script scripts/release/create-universal-journey-evidence.ts",
    "release:holdouts": "vite-node --script scripts/release/physical-holdouts.ts",
    "release:external-reviews": "vite-node --script scripts/release/external-reviews.ts",
    "evidence:acquire-external-reviews": "vite-node --script scripts/evidence/acquire-external-reviews.ts",
    "workspace:serve": "npm run workspace:build && node dist-workspace/workspace-server.js",
    "searxng:up": "node scripts/searxng-local.mjs up",
    "searxng:health": "node scripts/searxng-local.mjs health",
    "searxng:smoke": "node scripts/searxng-live-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "happy-dom": "^20.11.6",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@types/three": "^0.185.4",
    "pdf-parse": "2.4.5",
    "tesseract.js": "7.0.0",
    "three": "^0.185.1"
  }
}
