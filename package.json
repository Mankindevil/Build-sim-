{
  "name": "pc-build-sim",
  "version": "0.2.0-alpha",
  "private": true,
  "description": "Modular desktop / NAS PC build simulator — SKU library, occupancy conflict engine, wiring plans, and saved configs.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
